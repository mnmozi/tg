{
  "sg": {
    "required_tags": {
      "project": "salty",
      "component": "api"
    },
    "tags": {},
    "ingress_rules": [
      {
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "ipv6_cidr_blocks": [
          "::/0"
        ],
        "description": "Allow HTTPS from anywhere",
        "from_port": 443,
        "to_port": 443,
        "protocol": "tcp"
      }
    ],
    "ingress_sg": {},
    "egress_rules": [
      {
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "description": "Allow all outbound traffic",
        "from_port": 0,
        "to_port": 0,
        "protocol": "-1"
      }
    ],
    "egress_sg": {}
  },
  "ec2": {
    "required_tags": {
      "project": "salty",
      "component": "api"
    },
    "tags": {},
    "distro": "amazon-linux",
    "arch": "x86_64",
    "instance_type": "t3.small",
    "associate_public_ip_address": true,
    "key_name": "dev-instance",
    "root_block_device": {
      "delete_on_termination": true,
      "encrypted": true,
      "iops": 3000,
      "throughput": 125,
      "volume_size": 20,
      "volume_type": "gp3"
    }
  }
}
